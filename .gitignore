# Claude Code — local settings, worktrees, and project memory (not for public repo)
.claude/settings.local.json
.claude/worktrees/
.claude/projects/
.claude/scheduled_tasks.lock

# Lean build artifacts
**/.lake/
**/lake-packages/

# Python build artifacts
**/__pycache__/
**/*.pyc
**/*.pyo
**/.venv/
**/build/
**/dist/
**/*.egg-info/
**/.mypy_cache/
**/.pytest_cache/
**/.ruff_cache/

# Cython compiled extensions
**/*.so
**/*.pyd

# Data directories (licensed data — never commit)
**/data/*.parquet
**/data/*.csv
**/data/*.h5
**/data/*.arrow
**/data/raw/
**/data/processed/

# Jupyter
**/.ipynb_checkpoints/
**/*_files/
# Quarto rendered output (scenarios + reports): committed so GitHub renders the markdown
!foundations/portfolio-proofs/scenarios/**/*_files/
!foundations/portfolio-proofs/reports/**/*_files/

# Coverage artifacts (never commit; generated by pytest-cov locally and in CI)
**/.coverage
**/.coverage.*
**/coverage.xml
**/coverage.json
**/htmlcov/

# Mutation testing artifacts (mutmut)
**/mutmut-report/
**/.mutmut-cache

# macOS
**/.DS_Store
.claude/worktrees/

# Antigravity CLI
.antigravitycli/

# Pi agent runtime — generated copy of .claude/skills + .claude/agents (see setup_pi.sh),
# not a second source of truth. Regenerate with setup_pi.sh after any .claude/ change
# rather than hand-editing; never commit.
.pi/
foundations/optimization-proofs/pgd_ffi*.so
foundations/optimization-proofs/ffi/pgd_ffi.c
docs/_build/

# CI-generated copies of portfolio-proofs content (see .github/workflows/pages.yml
# "Copy portfolio content to docs/portfolio/" step). Source of truth is
# foundations/portfolio-proofs/scenarios/*/*.md and reports/lean_pgd_performance.md.
# docs/portfolio/index.md is hand-written and stays tracked.
docs/portfolio/boundary_trap.md
docs/portfolio/cholesky_crash.md
docs/portfolio/lean_pgd_performance.md
docs/portfolio/phantom_positions.md
docs/portfolio/precision_bleed.md
docs/portfolio/sp500_factor.md
docs/portfolio/step_divergence.md
docs/portfolio/vix_shock.md
docs/portfolio/*_files/
